{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "lib": [
      "ES2022"
    ]
  },
  "include": [
    "main.ts",
    "protocol.ts",
    "bridge.ts",
    "services/**/*.ts",
    "mcp/**/*.ts"
  ],
  "exclude": [
    "services/inspector.ts"
  ]
}
