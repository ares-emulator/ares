{
  "name": "ares-electron-spike",
  "version": "0.1.0",
  "private": true,
  "description": "Native ares to Electron canvas feasibility spike",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "test": "npm run build && node --test --test-concurrency=1 protocol.test.cjs tests/*.test.cjs",
    "fixture": "node fixture.cjs artifacts/spike.gb",
    "smoke": "node smoke.cjs",
    "build:services": "npm run build",
    "prestart": "npm run build",
    "test:session": "npm run build && node --test tests/session-live.test.cjs",
    "presmoke": "npm run build",
    "test:electron": "npm run build && electron tests/electron-session.mjs",
    "package:mac": "npm run build && node scripts/package-macos.cjs",
    "test:mcp": "npm run build && electron tests/electron-mcp.mjs",
    "test:package": "node tests/package-live.cjs",
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.browser.json && tsc -p tsconfig.preload.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:state-reference": "npm run build && node tests/state-reference.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "44.9.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "type": "module"
}
