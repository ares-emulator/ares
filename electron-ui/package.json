{
  "name": "ares-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Ares Workbench native emulator frontend",
  "main": "dist/main.js",
  "scripts": {
    "start": "node scripts/start.cjs",
    "test": "npm run build && node --test --test-concurrency=1 protocol.test.cjs tests/*.test.cjs",
    "fixture": "node fixture.cjs artifacts/spike.gb",
    "smoke": "node smoke.cjs",
    "build:services": "npm run build",
    "test:session": "npm run build && node --test tests/session-live.test.cjs",
    "presmoke": "npm run build",
    "test:electron": "npm run build && electron tests/electron-session.mjs",
    "package:mac": "npm run build && node scripts/package-macos.cjs",
    "test:mcp": "npm run build && electron tests/electron-mcp.mjs",
    "test:package": "node tests/package-live.cjs",
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.browser.json && tsc -p tsconfig.preload.json && node scripts/generate-sdk.cjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:state-reference": "npm run build && node tests/state-reference.cjs",
    "test:plugins": "npm run build && electron tests/electron-plugins.mjs",
    "test:reload": "npm run build && electron tests/electron-reload.mjs",
    "test:plugin-tools": "npm run build && electron tests/electron-plugin-tools.mjs",
    "test:kirby": "npm run build && electron tests/electron-kirby.mjs",
    "test:kirby-feedback": "npm run build && node tests/kirby-feedback-live.cjs",
    "plugin": "node dist/plugins/cli.js",
    "test:profiles": "npm run build && node tests/profile-live.cjs",
    "test:launch": "node tests/launch-live.cjs",
    "test:plugin-settings": "npm run build && electron tests/electron-plugin-settings.mjs",
    "test:workspace": "npm run build && electron tests/electron-workspace.mjs",
    "test:settings": "npm run build && electron tests/electron-settings.mjs",
    "test:recovery": "npm run build && electron tests/electron-recovery.mjs --disable-plugins",
    "accept": "node scripts/accept.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "44.9.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7",
    "esbuild": "0.28.2"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  }
}
